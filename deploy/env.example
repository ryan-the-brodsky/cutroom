# Copy to .env next to docker-compose.yml (or export in your shell).

# Bearer token the SPA + API clients must present. Empty = auth off (dev).
CUTROOM_AUTH_TOKEN=

# Token remote workers use to claim jobs (falls back to AUTH_TOKEN).
CUTROOM_WORKER_TOKEN=

# Wire the hosted director + voice lanes at first boot (optional).
ANTHROPIC_API_KEY=
ELEVEN_LABS_API_KEY=

# Postgres instead of the default SQLite (optional):
# CUTROOM_DATABASE_URL=postgresql+psycopg2://cutroom:pw@db/cutroom
